apiVersion: apps/v1
kind: Deployment
metadata:
  name: prediction-deployment
  namespace: log-anomaly
spec:
  replicas: 1
  selector:
    matchLabels:
      app: prediction-service
  template:
    metadata:
      labels:
        app: prediction-service
    spec:
      containers:
      - name: prediction-service
        image: preet1018/prediction-service:{{ prediction_tag | default('latest') }}
        ports:
        - containerPort: 8000
        env:
        - name: PROJECT_ROOT
          value: "/app"
        - name: MONGO_URI
          value: "mongodb://admin:admin@mongodb:27017/logs_db?authSource=admin"
        volumeMounts:
        - name: models-storage
          mountPath: /app/models
      volumes:
      - name: models-storage
        persistentVolumeClaim:
          claimName: models-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: prediction-service
  namespace: log-anomaly
spec:
  selector:
    app: prediction-service
  ports:
    - protocol: TCP
      port: 8000
      targetPort: 8000
